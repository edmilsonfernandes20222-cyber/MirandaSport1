<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestão de Equipa"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnAdicionarJogador"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Adicionar Jogador"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#1DB954"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnVerPlantel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Ver Plantel"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#1E88E5"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnFormacao"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Definir Formação Tática"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="← Voltar"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF" />

</LinearLayout>