<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicionar Jogador"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="8dp" />

        <!-- Nome -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Jogador"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ex: Cristiano Ronaldo"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#1DB954"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Posição -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Posição"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerPosicao"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1DB954"
            android:layout_marginBottom="16dp" />

        <!-- Número -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número da Camisola"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNumero"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ex: 7"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#1DB954"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Idade -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Idade"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etIdade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ex: 25"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#1DB954"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Pé Preferido -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pé Preferido"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerPe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1DB954"
            android:layout_marginBottom="32dp" />

        <!-- Botões -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar Jogador"
            android:textSize="16sp"
            android:backgroundTint="#1DB954"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="← Cancelar"
            android:textSize="16sp"
            android:backgroundTint="#424242"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>